[Desktop Entry]
Type=Application
Version=1.5
Name=RustWeather
GenericName=Weather
Comment=The temperature in your tray and a weather radar
Exec=rustweather
TryExec=rustweather
Icon=rustweather
Terminal=false
Categories=Utility;
Keywords=weather;radar;rain;temperature;forecast;tray;
StartupWMClass=io.github.vommie.rustweather
StartupNotify=true
SingleMainWindow=true
Actions=Radar;Settings;

[Desktop Action Radar]
Name=Radar
Exec=rustweather --open radar
Icon=rustweather

[Desktop Action Settings]
Name=Settings
Exec=rustweather --open settings
Icon=rustweather
