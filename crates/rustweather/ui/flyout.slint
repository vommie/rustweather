// The small panel above the tray icon.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { IconButton, Icon, TipArea, TipLayer } from "controls.slint";
import { HourData, NowData, RainBar } from "types.slint";

export component FlyoutWindow inherits Window {
    title: "RustWeather Card";
    no-frame: true;
    always-on-top: true;
    width: 320px;
    height: 372px;
    background: Theme.surface;
    in property <NowData> now;
    in property <[HourData]> hours;
    in property <[RainBar]> bars;
    in property <image> map;
    in property <image> rain;
    callback open-page(int);
    callback settings();
    callback refresh();
    callback closed();
    Rectangle {
        border-width: 1px;
        border-color: Theme.surface-selected;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 70px;
                    height: 50px;
                    border-radius: 6px;
                    background: root.now.tile;
                    Text { text: root.now.temperature; color: #ffffff; font-size: 19px; font-weight: 700; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.now.condition; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                    Text { text: "Feels like " + root.now.feels + " · " + root.now.range; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                    Text { text: root.now.place; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                }
            }
            if root.now.rain-line != "": Text { text: root.now.rain-line; color: Theme.primary; font-size: 12px; font-weight: 600; wrap: word-wrap; }
            if root.bars.length > 0: VerticalLayout {
                spacing: 2px;
                Text { text: "Rain at your place"; color: Theme.text-muted; font-size: 10px; }
                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 1px;
                        for b in root.bars: Rectangle {
                            Rectangle {
                                y: parent.height - self.height;
                                height: max(1px, parent.height * b.height);
                                background: b.past ? Theme.surface-selected : Theme.primary;
                            }
                        }
                    }
                    TipArea { tip: "Rain at your place from the radar: gray has fallen, blue is expected. The higher, the stronger."; }
                }
                HorizontalLayout {
                    Text { text: "Past"; color: Theme.text-muted; font-size: 10px; }
                    Text { text: "Expected"; color: Theme.primary; font-size: 10px; horizontal-stretch: 1; horizontal-alignment: right; }
                }
            }
            HorizontalLayout {
                for h in root.hours: VerticalLayout {
                    Text { text: h.label; color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; }
                    Text { text: h.temperature; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                }
            }
            Rectangle {
                border-radius: 4px;
                clip: true;
                vertical-stretch: 1;
                background: Theme.map-back;
                Image { width: 100%; height: 100%; source: root.map; image-fit: cover; }
                Image { width: 100%; height: 100%; source: root.rain; image-fit: cover; }
                TouchArea { clicked => { root.open-page(2); } }
            }
            HorizontalLayout {
                spacing: 4px;
                IconButton { icon: Icons.map; tip: "Radar"; clicked => { root.open-page(2); } }
                IconButton { icon: Icons.calendar; tip: "Forecast"; clicked => { root.open-page(1); } }
                IconButton { icon: Icons.sun; tip: "Details"; clicked => { root.open-page(0); } }
                IconButton { icon: Icons.refresh; tip: "Update now"; clicked => { root.refresh(); } }
                IconButton { icon: Icons.settings; tip: "Settings"; clicked => { root.settings(); } }
                Text { text: root.now.updated; color: Theme.text-muted; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }
    TipLayer { width: root.width; height: root.height; }
}
