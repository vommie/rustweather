// RustWeather's main window: a rail of pages, one page at a time, a one-line status at the bottom.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Card, Icon, IconButton, StatusLine, Tile, TipLayer, Toast } from "controls.slint";
import { MapChoice, AlertData, CityLabel, DayData, FrameCell, HourData, LayerRect, NowData, RainBar, TempLabel, ViewChip } from "types.slint";
import { NowPage } from "now_page.slint";
import { ForecastPage } from "forecast_page.slint";
import { RadarPage } from "radar_page.slint";
import { DesktopRow, HealthRow, PlaceRow, SettingsData, SettingsWindow, TrafficEntry, TrafficHost } from "settings.slint";
import { FlyoutWindow } from "flyout.slint";
import { MiniWindow } from "mini.slint";

export { Theme, MapChoice, SettingsWindow, SettingsData, PlaceRow, DesktopRow, HealthRow, TrafficEntry, TrafficHost, FlyoutWindow, MiniWindow, NowData, HourData, DayData, AlertData, FrameCell, CityLabel, LayerRect, RainBar, TempLabel, ViewChip }

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <string> tip;
    in property <int> badge;
    callback clicked();
    IconButton {
        width: 34px;
        height: 34px;
        icon: root.icon;
        tip: root.tip;
        tip-beside: true;
        checked: root.active;
        icon-size: 18px;
        clicked => { root.clicked(); }
    }
    if root.badge > 0: Rectangle {
        x: 24px;
        y: -2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.warn;
        Text { text: root.badge; color: Theme.on-primary; font-size: 9px; font-weight: 700; }
    }
    height: 34px;
    width: 34px;
}

component AlertsPage inherits ScrollView {
    in property <[AlertData]> alerts;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;
        if root.alerts.length == 0: Text { text: "No warnings for this place."; color: Theme.text-muted; }
        for a in root.alerts: Card {
            HorizontalLayout {
                spacing: 8px;
                Icon { source: Icons.alert-triangle; tint: a.level >= 3 ? Theme.error : Theme.warn; }
                Text { text: a.title; color: Theme.text; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
            }
            Text { text: a.time; color: Theme.text-muted; font-size: 11px; }
            Text { text: a.text; color: Theme.text; wrap: word-wrap; font-size: 12px; }
            if a.instruction != "": Text { text: a.instruction; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
        }
    }
}

export component MainWindow inherits Window {
    title: "RustWeather";
    icon: @image-url("../../../packaging/icons/rustweather-64.png");
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 460px;
    background: Theme.background;
    default-font-size: 13px;

    in-out property <int> page;
    in property <NowData> now;
    in property <[HourData]> hours;
    in property <[DayData]> days;
    in property <string> hours-path;
    in property <[AlertData]> alerts;
    in property <string> status;
    in property <int> status-level;
    in property <string> net-problem;
    in property <string> toast;
    in property <int> toast-level;
    in property <bool> full;

    in property <image> base;
    in property <image> warnings;
    in property <LayerRect> warnings-rect;
    in property <image> lightning;
    in property <LayerRect> lightning-rect;
    in property <image> clouds;
    in property <LayerRect> clouds-rect;
    in property <string> clouds-label: "Clouds";
    in property <image> rain;
    in property <image> wind;
    in property <image> labels;
    in property <[CityLabel]> cities;
    in property <[FrameCell]> frames;
    in property <int> live;
    in property <float> position;
    in property <bool> playing;
    in property <bool> looping;
    in property <string> time-label;
    in property <string> source-label;
    in property <float> loading;
    in property <string> banner;
    in property <bool> banner-error;
    in property <string> banner-action;
    in property <string> eta-title;
    in property <string> eta-text;
    in property <[RainBar]> bars;
    in property <string> probe-title;
    in property <string> probe-text;
    in property <length> probe-x;
    in property <length> probe-y;
    in property <length> home-x;
    in property <length> home-y;
    in property <string> scale-label;
    in property <length> scale-width;
    in property <[ViewChip]> views;
    in property <bool> layer-alerts;
    in property <bool> layer-clouds;
    in property <bool> layer-lightning;
    in property <bool> layer-wind;
    in property <bool> layer-temps;
    in property <bool> layer-heat;
    in property <image> heat;
    in property <LayerRect> heat-rect;
    in property <[string]> heat-ticks;
    in property <[MapChoice]> maps;
    in property <int> map-current;
    in property <string> map-credit;
    in property <[TempLabel]> temps;
    in property <[AlertData]> warning-panel;
    in property <string> warning-path;
    in property <LayerRect> warning-rect;
    in property <float> warning-path-width;
    in property <float> warning-path-height;
    in property <string> hover-path;
    in property <LayerRect> hover-rect;
    in property <float> hover-path-width;
    in property <float> hover-path-height;
    in property <string> warning-area;

    callback page-changed(int);
    callback open-settings();
    callback open-network();
    callback resized(length, length);
    callback pan(length, length);
    callback zoom(float, length, length);
    callback probe(length, length);
    callback probe-close();
    callback seek(float);
    callback toggle-play();
    callback toggle-loop();
    callback step(int);
    callback to-live();
    callback reload();
    callback pick-view(int);
    callback add-view();
    callback toggle-layer(int);
    callback toggle-full();
    callback mini();
    callback banner-act();
    callback warnings-close();
    callback hover(length, length);
    callback pick-map(int);
    callback map-picker(bool);

    forward-focus: radar-scope;
    HorizontalLayout {
        if !root.full: Rectangle {
            width: 46px;
            background: Theme.surface;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                RailButton { icon: Icons.sun; tip: "Now"; active: root.page == 0; clicked => { root.page = 0; root.page-changed(0); } }
                RailButton { icon: Icons.calendar; tip: "Forecast"; active: root.page == 1; clicked => { root.page = 1; root.page-changed(1); } }
                RailButton { icon: Icons.map; tip: "Radar"; active: root.page == 2; clicked => { root.page = 2; root.page-changed(2); } }
                RailButton { icon: Icons.alert-triangle; tip: "Warnings"; active: root.page == 3; badge: root.alerts.length; clicked => { root.page = 3; root.page-changed(3); } }
                Rectangle { vertical-stretch: 1; }
                RailButton { icon: Icons.settings; tip: "Settings"; clicked => { root.open-settings(); } }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                vertical-stretch: 1;
                if root.page == 0 && root.now.has-data: NowPage { now: root.now; }
                if root.page == 0 && !root.now.has-data: Text {
                    text: root.status == "" ? "Fetching the weather…" : root.status;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.page == 1 && root.days.length > 0: ForecastPage { hours: root.hours; days: root.days; hours-path: root.hours-path; }
                if root.page == 1 && root.days.length == 0: Text {
                    text: root.status == "" ? "Fetching the forecast…" : root.status;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                radar-scope := RadarPage {
                    visible: root.page == 2;
                    base: root.base;
                    warnings: root.warnings;
                    warnings-rect: root.warnings-rect;
                    lightning: root.lightning;
                    lightning-rect: root.lightning-rect;
                    clouds: root.clouds;
                    clouds-rect: root.clouds-rect;
                    clouds-label: root.clouds-label;
                    rain: root.rain;
                    wind: root.wind;
                    labels: root.labels;
                    cities: root.cities;
                    frames: root.frames;
                    live: root.live;
                    position: root.position;
                    playing: root.playing;
                    looping: root.looping;
                    time-label: root.time-label;
                    source-label: root.source-label;
                    loading: root.loading;
                    banner: root.banner;
                    banner-error: root.banner-error;
                    banner-action: root.banner-action;
                    eta-title: root.eta-title;
                    eta-text: root.eta-text;
                    bars: root.bars;
                    probe-title: root.probe-title;
                    probe-text: root.probe-text;
                    probe-x: root.probe-x;
                    probe-y: root.probe-y;
                    home-x: root.home-x;
                    home-y: root.home-y;
                    scale-label: root.scale-label;
                    scale-width: root.scale-width;
                    views: root.views;
                    layer-alerts: root.layer-alerts;
                    layer-clouds: root.layer-clouds;
                    layer-lightning: root.layer-lightning;
                    layer-wind: root.layer-wind;
                    layer-temps: root.layer-temps;
                    layer-heat: root.layer-heat;
                    heat: root.heat;
                    heat-rect: root.heat-rect;
                    heat-ticks: root.heat-ticks;
                    maps: root.maps;
                    map-current: root.map-current;
                    map-credit: root.map-credit;
                    temps: root.temps;
                    warning-panel: root.warning-panel;
                    warning-path: root.warning-path;
                    warning-rect: root.warning-rect;
                    warning-path-width: root.warning-path-width;
                    warning-path-height: root.warning-path-height;
                    hover-path: root.hover-path;
                    hover-rect: root.hover-rect;
                    hover-path-width: root.hover-path-width;
                    hover-path-height: root.hover-path-height;
                    warning-area: root.warning-area;
                    full: root.full;
                    resized(w, h) => { root.resized(w, h); }
                    pan(x, y) => { root.pan(x, y); }
                    zoom(s, x, y) => { root.zoom(s, x, y); }
                    probe(x, y) => { root.probe(x, y); }
                    probe-close => { root.probe-close(); }
                    seek(p) => { root.seek(p); }
                    toggle-play => { root.toggle-play(); }
                    toggle-loop => { root.toggle-loop(); }
                    step(n) => { root.step(n); }
                    to-live => { root.to-live(); }
                    reload => { root.reload(); }
                    pick-view(i) => { root.pick-view(i); }
                    add-view => { root.add-view(); }
                    toggle-layer(i) => { root.toggle-layer(i); }
                    toggle-full => { root.toggle-full(); }
                    mini => { root.mini(); }
                    banner-act => { root.banner-act(); }
                    warnings-close => { root.warnings-close(); }
                    hover(x, y) => { root.hover(x, y); }
                    pick-map(i) => { root.pick-map(i); }
                    map-picker(open) => { root.map-picker(open); }
                }
                if root.page == 3: AlertsPage { alerts: root.alerts; }
                if root.toast != "": Toast { x: parent.width - self.width - 12px; y: 42px; text: root.toast; level: root.toast-level; }
            }
            if !root.full: StatusLine {
                text: root.status;
                level: root.status-level;
                problem: root.net-problem;
                open-problem => { root.open-network(); }
            }
        }
    }
    TipLayer { width: root.width; height: root.height; }
}
