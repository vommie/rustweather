// The radar: map layers from Rust, gestures, timeline, playback. Everything on the map floats on it.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Chip, IconButton, Slider, ThinBar, Banner, Icon, TipArea } from "controls.slint";
import { AlertData, CityLabel, FrameCell, LayerRect, MapChoice, RainBar, TempLabel, ViewChip } from "types.slint";

export component Timeline inherits Rectangle {
    in property <[FrameCell]> frames;
    in property <int> live;
    in property <float> position;
    callback seek(float);
    height: 22px;
    property <length> cell: root.frames.length > 0 ? root.width / root.frames.length : root.width;
    HorizontalLayout {
        y: 7px;
        height: 8px;
        spacing: 1px;
        for f in root.frames: Rectangle {
            border-radius: 1px;
            background: f.state == 2 ? (f.forecast ? Theme.forecast : Theme.primary)
                : f.state == 1 ? Theme.accent : f.state == 3 ? Theme.error : Theme.surface-hover;
        }
    }
    if root.frames.length > 0: Rectangle {
        x: (root.live + 0.5) * root.cell - 1px;
        y: 3px;
        width: 2px;
        height: 16px;
        background: Theme.text;
    }
    if root.frames.length > 0: Rectangle {
        x: (root.position + 0.5) * root.cell - 4px;
        y: 1px;
        width: 8px;
        height: 20px;
        border-radius: 3px;
        background: Theme.accent;
        border-width: 1px;
        border-color: Theme.background;
    }
    TouchArea {
        mouse-cursor: pointer;
        function go(px: length) {
            root.seek(clamp(px / root.cell - 0.5, 0, root.frames.length - 1));
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.go(self.mouse-x); }
        }
        moved => { if self.pressed { self.go(self.mouse-x); } }
    }
}

export component RadarPage inherits Rectangle {
    in property <image> base;
    in property <image> warnings;
    in property <LayerRect> warnings-rect;
    in property <image> lightning;
    in property <LayerRect> lightning-rect;
    in property <image> clouds;
    in property <LayerRect> clouds-rect;
    in property <image> heat;
    in property <LayerRect> heat-rect;
    in property <[string]> heat-ticks;
    in property <string> clouds-label: "Clouds";
    in property <image> rain;
    in property <image> wind;
    in property <image> labels;
    in property <[CityLabel]> cities;
    in property <[FrameCell]> frames;
    in property <int> live;
    in property <float> position;
    in property <bool> playing;
    in property <bool> looping;
    in property <string> time-label;
    in property <string> source-label;
    in property <float> loading;
    in property <string> banner;
    in property <bool> banner-error;
    in property <string> banner-action;
    in property <string> eta-title;
    in property <string> eta-text;
    in property <[RainBar]> bars;
    in property <string> probe-title;
    in property <string> probe-text;
    in property <length> probe-x;
    in property <length> probe-y;
    in property <length> home-x;
    in property <length> home-y;
    in property <string> scale-label;
    in property <length> scale-width;
    in property <[ViewChip]> views;
    in property <bool> layer-alerts;
    in property <bool> layer-clouds;
    in property <bool> layer-lightning;
    in property <bool> layer-wind;
    in property <bool> layer-temps;
    in property <bool> layer-heat;
    in property <[MapChoice]> maps;
    in property <int> map-current;
    in property <string> map-credit;
    in property <[TempLabel]> temps;
    in property <[AlertData]> warning-panel;
    in property <string> warning-path;
    in property <LayerRect> warning-rect;
    in property <float> warning-path-width;
    in property <float> warning-path-height;
    in property <string> hover-path;
    in property <LayerRect> hover-rect;
    in property <float> hover-path-width;
    in property <float> hover-path-height;
    in property <string> warning-area;
    in property <bool> full;
    callback resized(length, length);
    callback pan(length, length);
    callback zoom(float, length, length);
    callback probe(length, length);
    callback probe-close();
    callback seek(float);
    callback toggle-play();
    callback toggle-loop();
    callback step(int);
    callback to-live();
    callback reload();
    callback pick-view(int);
    callback add-view();
    callback toggle-layer(int);
    callback toggle-full();
    callback mini();
    callback banner-act();
    callback warnings-close();
    callback hover(length, length);
    callback pick-map(int);
    callback map-picker(bool);
    property <bool> map-open;
    changed map-open => { root.map-picker(self.map-open); }
    property <length> top: root.banner != "" ? 42px : 8px;
    background: Theme.map-back;
    clip: true;
    forward-focus: keys;
    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
    init => { root.resized(self.width, self.height); }

    Image { width: 100%; height: 100%; source: root.base; image-fit: fill; }
    Image { x: root.heat-rect.x; y: root.heat-rect.y; width: root.heat-rect.width; height: root.heat-rect.height; source: root.heat; image-fit: fill; opacity: 0.6; }
    Image { x: root.clouds-rect.x; y: root.clouds-rect.y; width: root.clouds-rect.width; height: root.clouds-rect.height; source: root.clouds; image-fit: fill; }
    Image { x: root.warnings-rect.x; y: root.warnings-rect.y; width: root.warnings-rect.width; height: root.warnings-rect.height; source: root.warnings; image-fit: fill; opacity: 0.65; }
    Image { x: root.lightning-rect.x; y: root.lightning-rect.y; width: root.lightning-rect.width; height: root.lightning-rect.height; source: root.lightning; image-fit: fill; }
    if root.hover-path != "" && root.hover-path != root.warning-path: Path {
        x: root.hover-rect.x;
        y: root.hover-rect.y;
        width: root.hover-rect.width;
        height: root.hover-rect.height;
        viewbox-width: root.hover-path-width;
        viewbox-height: root.hover-path-height;
        commands: root.hover-path;
        fill: Theme.text.with-alpha(0.12);
        stroke: Theme.text.with-alpha(0.6);
        stroke-width: 1px;
    }
    if root.warning-path != "": Path {
        x: root.warning-rect.x;
        y: root.warning-rect.y;
        width: root.warning-rect.width;
        height: root.warning-rect.height;
        viewbox-width: root.warning-path-width;
        viewbox-height: root.warning-path-height;
        commands: root.warning-path;
        fill: Theme.accent.with-alpha(0.25);
        stroke: Theme.accent;
        stroke-width: 2.5px;
    }
    Image { width: 100%; height: 100%; source: root.rain; image-fit: fill; }
    Image { width: 100%; height: 100%; source: root.wind; image-fit: fill; }
    Image { width: 100%; height: 100%; source: root.labels; image-fit: fill; }
    for t in root.temps: Rectangle {
        x: t.x - self.width / 2;
        y: t.y - self.height / 2;
        width: pill.preferred-width;
        height: 18px;
        border-radius: 5px;
        background: t.color;
        pill := HorizontalLayout {
            padding-left: 5px;
            padding-right: 5px;
            spacing: 4px;
            Text { text: t.text; color: #ffffff; font-size: 12px; font-weight: 700; vertical-alignment: center; }
            Text { text: t.name; color: #ffffff; font-size: 10px; vertical-alignment: center; overflow: elide; max-width: 76px; }
        }
    }
    for c in root.cities: Text {
        x: c.x + 6px;
        y: c.y - 8px;
        text: c.name;
        color: Theme.text;
        font-size: 11px;
    }
    Rectangle {
        x: root.home-x - 6px;
        y: root.home-y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.background;
    }

    // Below the touch area: above it, this scope would swallow the first press on the map.
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == " " { root.toggle-play(); return accept; }
            if e.text == Key.LeftArrow { root.step(-1); return accept; }
            if e.text == Key.RightArrow { root.step(1); return accept; }
            if e.text == "+" || e.text == "=" { root.zoom(0.5, root.width / 2, root.height / 2); return accept; }
            if e.text == "-" { root.zoom(-0.5, root.width / 2, root.height / 2); return accept; }
            if e.text == "l" { root.to-live(); return accept; }
            if e.text == "f" { root.toggle-full(); return accept; }
            if e.text == "r" { root.reload(); return accept; }
            if e.text >= "1" && e.text <= "9" { root.pick-view(e.text.to-float() - 1); return accept; }
            if e.text == "0" { root.pick-view(0); return accept; }
            reject
        }
    }

    property <length> last-x;
    property <length> last-y;
    property <bool> dragged;
    touch := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                keys.focus();
                root.map-open = false;
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
                root.dragged = false;
            }
        }
        moved => {
            if self.pressed {
                root.pan(self.mouse-x - root.last-x, self.mouse-y - root.last-y);
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
                root.dragged = true;
            }
        }
        clicked => { if !root.dragged { root.probe(self.mouse-x, self.mouse-y); } }
        double-clicked => { root.zoom(1, self.mouse-x, self.mouse-y); }
        scroll-event(e) => {
            root.zoom(e.delta-y > 0 ? 0.33 : e.delta-y < 0 ? -0.33 : 0, self.mouse-x, self.mouse-y);
            accept
        }
    }

    // Asks about the area under the pointer once it has come to rest, not on its way there.
    property <length> rest-x;
    property <length> rest-y;
    property <int> rest-ticks;
    Timer {
        interval: 150ms;
        running: root.layer-alerts && touch.has-hover && !touch.pressed;
        triggered => {
            if touch.mouse-x != root.rest-x || touch.mouse-y != root.rest-y {
                root.rest-x = touch.mouse-x;
                root.rest-y = touch.mouse-y;
                root.rest-ticks = 0;
            } else {
                root.rest-ticks += 1;
                if root.rest-ticks == 2 { root.hover(root.rest-x, root.rest-y); }
            }
        }
    }

    ThinBar { y: 0; progress: root.loading; visible: root.loading > 0; }

    VerticalLayout {
        padding: 8px;
        padding-top: root.top;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for v[i] in root.views: Chip {
                text: v.name;
                key: i < 9 ? i + 1 : "";
                checked: v.active;
                clicked => { root.pick-view(i); }
            }
            IconButton { icon: Icons.plus; tip: "Save this view"; height: 26px; clicked => { root.add-view(); } }
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Chip { tip: "Map: " + root.maps[root.map-current].name; icon: Icons.map; has-icon: true; checked: root.map-open; clicked => { root.map-open = !root.map-open; } }
            Chip { tip: "Warnings: official DWD warnings by district, the stronger the darker. Click an area for the full text"; icon: Icons.alert-triangle; has-icon: true; checked: root.layer-alerts; clicked => { root.toggle-layer(0); } }
            Chip { tip: root.clouds-label + ": satellite picture of the clouds, a new one comes every three hours"; icon: Icons.cloud; has-icon: true; checked: root.layer-clouds; clicked => { root.toggle-layer(1); } }
            Chip { tip: "Lightning: strikes of the last hours, from the DWD"; icon: Icons.bolt; has-icon: true; checked: root.layer-lightning; clicked => { root.toggle-layer(2); } }
            Chip { tip: "Wind: the lines flow with the current wind, the scale is at the bottom right"; icon: Icons.wind; has-icon: true; checked: root.layer-wind; clicked => { root.toggle-layer(3); } }
            Chip { tip: "Temperature: current values of the cities, the closer you zoom in the more of them"; icon: Icons.temperature; has-icon: true; checked: root.layer-temps; clicked => { root.toggle-layer(4); } }
            Chip { tip: "Heatmap: current temperature as colors over the map, the scale is at the bottom right"; icon: Icons.palette; has-icon: true; checked: root.layer-heat; clicked => { root.toggle-layer(5); } }
        }
    }

    if root.map-open: Rectangle {
        x: 8px;
        y: root.top + 64px;
        width: 3 * 116px + 2 * 6px + 16px;
        height: 4 * 88px + 3 * 6px + 16px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.surface-selected;
        border-radius: 8px;
        TouchArea { }
        for m[i] in root.maps: Rectangle {
            x: 8px + mod(i, 3) * 122px;
            y: 8px + floor(i / 3) * 94px;
            width: 116px;
            height: 88px;
            border-radius: 6px;
            border-width: i == root.map-current ? 2px : 1px;
            border-color: i == root.map-current ? Theme.primary : pick.has-hover && !m.needs-key ? Theme.text-muted : Theme.border;
            background: i == root.map-current ? Theme.surface.mix(Theme.primary, 0.75) : pick.has-hover && !m.needs-key ? Theme.surface-hover : transparent;
            Rectangle {
                x: 3px;
                y: 3px;
                width: parent.width - 6px;
                height: 64px;
                border-radius: 4px;
                clip: true;
                background: Theme.surface-hover;
                Image { width: 100%; height: 100%; source: m.thumb; image-fit: cover; opacity: m.needs-key ? 0.3 : 1; }
                if m.thumb.width == 0: Text { text: "Loading…"; color: Theme.text-muted; font-size: 10px; }
            }
            Text {
                x: 6px;
                y: 68px;
                width: parent.width - 12px;
                height: 18px;
                text: m.name;
                color: m.needs-key ? Theme.text-disabled : i == root.map-current ? Theme.primary : Theme.text;
                font-size: 11px;
                font-weight: i == root.map-current ? 600 : 400;
                overflow: elide;
                vertical-alignment: center;
            }
            pick := TipArea {
                tip: m.needs-key ? "This map needs a CARTO API key. Add one in the settings, on the page Sources" : "";
                mouse-cursor: m.needs-key ? MouseCursor.not-allowed : MouseCursor.pointer;
                clicked => {
                    if !m.needs-key {
                        root.map-open = false;
                        root.pick-map(i);
                    }
                }
            }
        }
    }

    if root.eta-title != "": Rectangle {
        x: 8px;
        y: root.height - 42px - self.height - 8px - 18px;
        width: 240px;
        height: info.preferred-height + 16px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 6px;
        info := VerticalLayout {
            padding: 8px;
            spacing: 2px;
            Text { text: root.eta-title; color: Theme.text; font-size: 15px; font-weight: 700; }
            Text { text: root.eta-text; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
            if root.bars.length > 0: HorizontalLayout {
                height: 30px;
                spacing: 1px;
                for b in root.bars: Rectangle {
                    Rectangle {
                        y: parent.height - self.height;
                        height: max(1px, parent.height * b.height);
                        background: b.past ? Theme.surface-selected : Theme.primary;
                    }
                }
            }
        }
    }

    if root.probe-title != "": Rectangle {
        x: root.probe-x + 10px;
        y: root.probe-y + 10px;
        width: 210px;
        height: probe-box.preferred-height + 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 6px;
        probe-box := VerticalLayout {
            padding: 7px;
            Text { text: root.probe-title; color: Theme.text; font-size: 12px; font-weight: 600; }
            Text { text: root.probe-text; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
        }
        TipArea {
            tip: "Right-click to close";
            pointer-event(e) => {
                if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { root.probe-close(); }
            }
        }
    }

    // Legend and scale.
    Rectangle {
        x: root.width - self.width - 8px;
        y: root.height - 42px - self.height - 8px;
        width: 214px;
        height: 42px + (root.layer-wind ? 24px : 0) + (root.layer-heat ? 24px : 0);
        background: Theme.scrim;
        border-radius: 4px;
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 5px;
            spacing: 2px;
            Rectangle {
                height: 8px;
                border-radius: 2px;
                background: @linear-gradient(90deg, #74c7ec 0%, #3b82f6 20%, #22c55e 42%, #facc15 62%, #f97316 80%, #ef4444 92%, #d946ef 100%);
            }
            HorizontalLayout {
                Text { text: "0.1"; color: Theme.text-muted; font-size: 9px; }
                Text { text: "1"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; horizontal-stretch: 1; }
                Text { text: "10"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; horizontal-stretch: 1; }
                Text { text: "100 mm/h"; color: Theme.text-muted; font-size: 9px; }
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle { y: 5px; width: root.scale-width; height: 2px; background: Theme.text-muted; }
                Text { text: root.scale-label; color: Theme.text-muted; font-size: 9px; }
                Text { text: root.source-label; color: Theme.text-muted; font-size: 9px; horizontal-stretch: 1; horizontal-alignment: right; }
            }
            if root.layer-wind: Rectangle {
                height: 5px;
                border-radius: 2px;
                background: @linear-gradient(90deg, Theme.text 0%, Theme.text 33%, #facc15 61%, #ef4444 100%);
            }
            if root.layer-wind: HorizontalLayout {
                Text { text: "Wind 0"; color: Theme.text-muted; font-size: 9px; }
                Text { text: "30"; color: Theme.text-muted; font-size: 9px; horizontal-stretch: 1; horizontal-alignment: center; }
                Text { text: "90 km/h"; color: Theme.text-muted; font-size: 9px; horizontal-stretch: 1; horizontal-alignment: right; }
            }
            if root.layer-heat: Rectangle {
                height: 5px;
                border-radius: 2px;
                background: @linear-gradient(90deg, #5a4fcf 0%, #356fd6 20%, #1f7fbf 37%, #13857c 51%, #2f853f 63%, #a86e0b 76%, #cc550c 88%, #d02b4a 100%);
            }
            if root.layer-heat: HorizontalLayout {
                Text { text: root.heat-ticks[0]; color: Theme.text-muted; font-size: 9px; }
                Text { text: root.heat-ticks[1]; color: Theme.text-muted; font-size: 9px; horizontal-stretch: 1; horizontal-alignment: center; }
                Text { text: root.heat-ticks[2]; color: Theme.text-muted; font-size: 9px; horizontal-stretch: 1; horizontal-alignment: right; }
            }
        }
    }

    if root.map-credit != "": Rectangle {
        x: 8px;
        y: root.height - 42px - self.height - 6px;
        width: credit.preferred-width + 10px;
        height: 14px;
        background: Theme.scrim;
        border-radius: 3px;
        credit := Text { text: root.map-credit; color: Theme.text-muted; font-size: 9px; }
    }

    // Playback.
    Rectangle {
        x: 6px;
        y: root.height - self.height - 6px;
        width: root.width - 12px;
        height: 38px;
        background: Theme.scrim;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 6px;
        HorizontalLayout {
            padding: 6px;
            spacing: 3px;
            IconButton {
                icon: root.playing ? Icons.player-pause : Icons.player-play;
                tip: "Play or pause (Space)";
                primary: true;
                clicked => { root.toggle-play(); }
            }
            IconButton { icon: Icons.player-track-prev; tip: "One picture back (Left)"; clicked => { root.step(-1); } }
            IconButton { icon: Icons.player-track-next; tip: "One picture ahead (Right)"; clicked => { root.step(1); } }
            IconButton { icon: Icons.player-skip-forward; tip: "Jump to now (L)"; clicked => { root.to-live(); } }
            IconButton { icon: Icons.repeat; tip: "Repeat"; checked: root.looping; clicked => { root.toggle-loop(); } }
            Rectangle {
                horizontal-stretch: 1;
                Timeline {
                    x: 8px;
                    y: 2px;
                    width: parent.width - 16px;
                    frames: root.frames;
                    live: root.live;
                    position: root.position;
                    seek(p) => { root.seek(p); }
                }
            }
            Text { text: root.time-label; color: Theme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; min-width: 96px; horizontal-alignment: right; }
            IconButton { icon: Icons.refresh; tip: "Reload (R)"; clicked => { root.reload(); } }
            IconButton { icon: Icons.pin; tip: "Small radar window, always on top"; clicked => { root.mini(); } }
            IconButton { icon: Icons.maximize; tip: "Fullscreen (F)"; checked: root.full; clicked => { root.toggle-full(); } }
        }
    }

    // The full warnings for a clicked place, floating on the right.
    if root.warning-panel.length > 0: Rectangle {
        x: root.width - self.width - 8px;
        y: root.top;
        width: min(350px, root.width * 0.45);
        height: root.height - self.y - 54px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.surface-selected;
        border-radius: 8px;
        TouchArea { }
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                Icon { source: Icons.alert-triangle; tint: Theme.warn; width: 18px; height: 18px; y: 4px; }
                Text { text: root.warning-area != "" ? root.warning-area : "Warnings"; color: Theme.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                IconButton { icon: Icons.x; tip: "Close"; clicked => { root.warnings-close(); } }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    for a in root.warning-panel: VerticalLayout {
                        spacing: 3px;
                        Text { text: a.title; color: a.level >= 3 ? Theme.error : Theme.warn; font-weight: 700; wrap: word-wrap; }
                        Text { text: a.time; color: Theme.text-muted; font-size: 11px; }
                        Text { text: a.text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                        if a.instruction != "": Text { text: a.instruction; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    if root.banner != "": Banner {
        y: 0;
        text: root.banner;
        error: root.banner-error;
        action: root.banner-action;
        act => { root.banner-act(); }
    }
}
