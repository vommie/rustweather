// The data the UI shows. Rust fills these (src/models.rs); nothing here is computed from weather values.

export struct MapChoice { name: string, thumb: image, needs-key: bool }

export struct NowData {
    has-data: bool,
    place: string,
    temperature: string,
    condition: string,
    feels: string,
    range: string,
    wind: string,
    gust: string,
    humidity: string,
    dew: string,
    pressure: string,
    visibility: string,
    precipitation: string,
    clouds: string,
    uv: string,
    air: string,
    air-detail: string,
    pollen: string,
    sunrise: string,
    sunset: string,
    moon: string,
    station: string,
    measured: string,
    updated: string,
    rain-line: string,
    tile: color,
    history-path: string,
    history-fill: string,
    history-low: string,
    history-high: string,
    weather: int,
    wind-to: float,
    humidity-share: float,
    uv-share: float,
    uv-word: string,
    air-color: color,
    pollen-detail: string,
    sun-share: float,
    sun-up: bool,
    daylight: string,
    moon-share: float,
    moon-lit: string,
}

export struct HourData { label: string, temperature: string, rain: float, rain-text: string, probability: string, height: float, weather: int, tip: string }
export struct DayData { label: string, condition: string, low: string, high: string, rain: string, start: float, end: float, color: color, weather: int, tip: string }
export struct AlertData { title: string, text: string, instruction: string, time: string, level: int }
export struct TempLabel { x: length, y: length, text: string, name: string, color: color }
export struct FrameCell { state: int, forecast: bool }
export struct CityLabel { name: string, x: length, y: length }
export struct RainBar { height: float, past: bool }
export struct LayerRect { x: length, y: length, width: length, height: length }
export struct ViewChip { name: string, active: bool }
