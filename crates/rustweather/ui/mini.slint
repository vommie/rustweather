// The small radar window that stays on top.

import { Theme } from "theme.slint";

export component MiniWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "RustWeather Radar";
    icon: @image-url("../../../packaging/icons/rustweather-64.png");
    preferred-width: 320px;
    preferred-height: 220px;
    min-width: 200px;
    min-height: 140px;
    background: Theme.map-back;
    in property <image> base;
    in property <image> rain;
    in property <string> time-label;
    in property <string> map-credit;
    callback restore();
    callback drag(length, length);
    Image { width: 100%; height: 100%; source: root.base; image-fit: cover; }
    Image { width: 100%; height: 100%; source: root.rain; image-fit: cover; }
    Rectangle {
        y: parent.height - 18px;
        height: 18px;
        background: Theme.scrim;
        Text { x: 6px; text: root.time-label; color: Theme.text; font-size: 11px; font-weight: 700; }
        Text { x: parent.width - self.width - 6px; text: root.map-credit; color: Theme.text-muted; font-size: 8px; }
    }
    TouchArea {
        property <length> px;
        property <length> py;
        double-clicked => { root.restore(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.px = self.mouse-x; self.py = self.mouse-y; }
        }
        moved => { if self.pressed { root.drag(self.mouse-x - self.px, self.mouse-y - self.py); } }
    }
}
